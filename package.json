{
  "name": "amrutam-backend",
  "version": "1.0.0",
  "description": "Production-grade telemedicine backend for Amrutam (modular monolith: API + worker)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "migrate": "tsx scripts/migrate.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "gen:env": "tsx scripts/gen-env.ts",
    "totp": "tsx scripts/totp.ts",
    "keys:rotate": "tsx scripts/rotate-keys.ts",
    "demo": "tsx scripts/demo.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:coverage": "vitest run --coverage",
    "bench": "tsx scripts/bench.ts",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "audit:deps": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-ioredis": "^0.72.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "jose": "^5.10.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "autocannon": "^8.0.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
